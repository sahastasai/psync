import Lake
open Lake DSL

/-- The machine-checked parts of psync. Core library only: no dependencies, no downloads. -/
package psync_verify

@[default_target]
lean_lib PsyncVerify where
  roots := #[`Schedule, `Tutorial, `World, `Cert, `Footprint]

/-- Certificates of real schedules, generated by `psync-cert` (CI regenerates them). -/
lean_lib GeneratedCerts where
  roots := #[`Certs]
